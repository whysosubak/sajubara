OPENAI_API_KEY=
# Legacy fallback: OPENAI_MODEL is still supported for the full report model.
OPENAI_MODEL=
OPENAI_MODEL_FULL=gpt-4o
OPENAI_MODEL_LITE=gpt-4o-mini

NEXT_PUBLIC_SITE_URL=https://sajubara.com
# Set false for a private soft launch that should not be indexed.
NEXT_PUBLIC_INDEX_SITE=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# checkout mode: mock | portone
NEXT_PUBLIC_CHECKOUT_MODE=mock

# Required only when NEXT_PUBLIC_CHECKOUT_MODE=portone
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
NEXT_PUBLIC_PORTONE_PAY_METHOD=CARD
PORTONE_API_SECRET=
